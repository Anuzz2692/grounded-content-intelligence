# Which AI to use: auto (Claude first, Ollama if Claude fails), ollama (local only), anthropic (Claude only).
# With no Anthropic key, set this to ollama.
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Fallback model. Ensure it is installed locally: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Access control for POST /api/v1/content/generate.
# Comma-separated keys sent in the X-API-Key header. Leave empty to disable auth (local dev only).
API_KEYS=
# Requests per client per minute (per key, or per IP when auth is off). 0 disables the limit.
RATE_LIMIT_PER_MINUTE=10

# Performance / research limits
REQUEST_TIMEOUT_SECONDS=12
# Long pages (about 5,000 output tokens) take over a minute, so keep this generous.
LLM_TIMEOUT_SECONDS=150
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=8192
# The context window grows to fit long prompts, up to this limit (higher = more RAM).
OLLAMA_MAX_CTX=16384
# Research text sent to local models (smaller than MAX_RESEARCH_CHARS, because they have short contexts).
OLLAMA_MAX_RESEARCH_CHARS=12000
CACHE_TTL_SECONDS=300
MAX_PAGES_TO_FETCH=8
MAX_CHARS_PER_PAGE=9000
MAX_RESEARCH_CHARS=26000
# Base output budget. Each format and length scales from it (a detailed website page gets about 2.5x).
MAX_OUTPUT_TOKENS=2200
# The brand check can list many issues, which needs room.
VALIDATOR_MAX_TOKENS=6000
# One automatic fix pass when the output misses the required counts or sections (adds one model call).
FORMAT_REPAIR=true
# A natural-writing pass after the draft is written (one more model call; each request can turn it off).
HUMANIZE_ENABLED=true

# One more targeted rewrite when the first still leaves formulaic wording (rare).
HUMANIZE_SECOND_PASS=true

# Which company the studio writes for: a folder under companies/ (see README, "Writing for another company").
# Leave WEBSITE_BASE_URL empty to use the website_url in that company's profile.json.
COMPANY=example_company
WEBSITE_BASE_URL=
